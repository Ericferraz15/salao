# Copie para .env e ajuste os valores antes de subir o Docker.

# ─── Django ────────────────────────────────────────────────────────────────────
# Gere uma chave forte, por exemplo:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=gere-uma-chave-segura

# Em PRODUÇÃO use False (True expõe páginas de erro com detalhes internos).
DJANGO_DEBUG=False

# Domínios/IPs que podem acessar o site, separados por vírgula.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Ligue (=1) SÓ quando o site tiver HTTPS de verdade (certificado).
# Em rede local via http:// deixe 0, senão o login não funciona.
DJANGO_HTTPS=0

# ─── PostgreSQL ────────────────────────────────────────────────────────────────
USE_POSTGRES=1
POSTGRES_DB=django_db
POSTGRES_USER=seu_usuario
POSTGRES_PASSWORD=sua_senha
POSTGRES_HOST=db
POSTGRES_PORT=5432
