# Copie para .env e ajuste os valores antes de subir o Docker.

# ─── Django ────────────────────────────────────────────────────────────────────
# Gere uma chave forte, por exemplo:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=gere-uma-chave-segura

# Em PRODUÇÃO use False (True expõe páginas de erro com detalhes internos).
DJANGO_DEBUG=False

# Domínios/IPs que podem acessar o site, separados por vírgula.
# Em produção inclua o domínio: 127.0.0.1,localhost,seu-dominio.com.br
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Origens confiáveis para formulários (obrigatório em produção!).
# Sem isto, com domínio + HTTPS todo POST falha com "CSRF verification failed".
# Ex.: DJANGO_CSRF_TRUSTED_ORIGINS=https://seu-dominio.com.br
DJANGO_CSRF_TRUSTED_ORIGINS=

# Ligue (=1) SÓ quando o site tiver HTTPS de verdade (certificado).
# Na stack de produção (docker-compose.prod.yml, Caddy na frente) use 1.
# Em rede local via http:// deixe 0, senão o login não funciona.
DJANGO_HTTPS=0

# Domínio do site — usado pelo Caddy (docker-compose.prod.yml) para obter
# o certificado HTTPS automaticamente. Sem www; o DNS deve apontar pra cá.
DOMINIO=seu-dominio.com.br

# ─── Login com Google (opcional) ───────────────────────────────────────────────
# Com o client_id preenchido, aparece o botão "Entrar com o Google" nas telas
# de login e cadastro. Vazio, o site funciona normalmente só com e-mail/senha.
#
# Como criar o client_id (uma vez só):
#   1. https://console.cloud.google.com/apis/credentials → "Criar credenciais"
#      → "ID do cliente OAuth" → tipo "Aplicativo da Web".
#   2. Em "Origens JavaScript autorizadas", adicione os endereços do site,
#      ex.: http://localhost:8000 e https://seu-dominio.com.br
#   3. Copie o "ID do cliente" (termina com .apps.googleusercontent.com).
# Obs.: fora do localhost, o Google exige HTTPS — em rede local via http://
# o botão não funciona (limitação do Google, não do site).
GOOGLE_OAUTH_CLIENT_ID=

# ─── PostgreSQL ────────────────────────────────────────────────────────────────
USE_POSTGRES=1
POSTGRES_DB=django_db
POSTGRES_USER=seu_usuario
POSTGRES_PASSWORD=sua_senha
POSTGRES_HOST=db
POSTGRES_PORT=5432
